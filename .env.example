# Copie este arquivo para ".env" e ajuste se precisar.

# Sem DATABASE_URL, a API usa um arquivo SQLite local (consultas.db).
# Para usar o MySQL do docker-compose rodando a API fora do Docker:
# DATABASE_URL=mysql+pymysql://agenda:agenda123@localhost:3306/agenda_consultas

# Cadastra especialidades e médicos de exemplo quando o banco está vazio.
CARREGAR_DADOS_EXEMPLO=true
